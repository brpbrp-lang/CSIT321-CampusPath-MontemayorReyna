# Copy this file to local.properties (same folder) and fill in your own MySQL login.
# local.properties is git-ignored, so your password never goes to GitHub.
# XAMPP's default is user "root" with an empty password, so you may not need this file at all.

DB_USERNAME=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://localhost:3306/campuspath_db?createDatabaseIfNotExist=true&serverTimezone=Asia/Manila
